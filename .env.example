# Upstash Redis 접속 정보
# 두 값이 모두 없으면 앱은 자동으로 브라우저 localStorage 저장소로 동작합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Marketplace 에서 Upstash 를 연동하면 아래처럼 "<접두사>_REST_API_URL / _REST_API_TOKEN" 이름으로
# 자동 주입되는데, 이 형태도 그대로 인식합니다 (접두사는 KV, STORAGE 등 무엇이든 가능).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
